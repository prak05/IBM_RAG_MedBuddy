# ============================================================================
# .env.example — Environment Variables Template for MedBuddy Backend
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to git!
# ============================================================================

# --- IBM Watsonx Configuration ---
# Get these from: https://cloud.ibm.com/apidocs/watsonx-ai
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_ibm_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- HuggingFace Configuration ---
# Get your token from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_api_token_here

# --- Supabase Configuration ---
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# --- NCBI PubMed API (Optional) ---
# Register at: https://www.ncbi.nlm.nih.gov/account/settings/
# Having an API key increases rate limit from 3 to 10 requests/second
NCBI_API_KEY=your_ncbi_api_key_here
